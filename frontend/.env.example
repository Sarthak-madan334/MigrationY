# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================

# The base URL of the FastAPI backend.
# 
# [Local Development]
# Point this to your locally running FastAPI server (usually port 8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# [Production (Vercel)]
# When deploying this frontend to Vercel, you MUST set this environment variable
# in your Vercel Project Settings to point to your live, publicly deployed backend.
# Example:
# NEXT_PUBLIC_API_URL=https://my-deployed-backend.fly.dev